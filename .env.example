# DeepSeek — primary chat LLM. Get key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google AI (Gemini) — used only for FAQ embeddings (text-embedding-001).
# Free tier is enough for the demo. Get key at https://aistudio.google.com/app/apikey
