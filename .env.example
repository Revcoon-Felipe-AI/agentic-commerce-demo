# =====================================================================
# REQUIRED — chat will not work without these.
# =====================================================================

# DeepSeek — primary chat LLM. Get key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google AI (Gemini) — used only for FAQ embeddings (gemini-embedding-001 truncated to 768 dims).
# Free tier is enough for the demo. Get key at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase — create a project at https://supabase.com/dashboard, copy these from Project Settings → API.
# SERVICE_KEY is server-only (bypasses RLS); never expose it client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# =====================================================================
# OPTIONAL — app runs fine without these (rate limit fails open in dev).
# =====================================================================

# Vercel KV (rate limit) — provisioned via `vercel kv create linden-ratelimit`.
# Without these, /api/chat is unconstrained locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# CTAs (links rendered in Footer / About). Default to repo + portfolio.
NEXT_PUBLIC_GITHUB_URL=https://github.com/Revcoon-Felipe-AI/agentic-commerce-demo
NEXT_PUBLIC_UPWORK_URL=https://upwork.com/freelancers/felipemoreira

# Used by Open Graph / Twitter card metadata. Leave blank for localhost.
NEXT_PUBLIC_SITE_URL=
